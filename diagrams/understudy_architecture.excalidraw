    { "id": "z5_left_num", "type": "text", "x": 2116, "y": 150, "width": 230, "height": 100, "text": "88%", "originalText": "88%", "fontSize": 72, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#a8452f", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "groupIds": [], "seed": 160005, "version": 1, "versionNonce": 160005, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false },
    { "id": "z5_left_caption", "type": "text", "x": 2116, "y": 270, "width": 230, "height": 50, "text": "14/16 — wrong. An\nImportError also exits\nnon-zero.", "originalText": "14/16 — wrong. An ImportError also exits non-zero.", "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#5b1c10", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "groupIds": [], "seed": 160006, "version": 1, "versionNonce": 160006, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false },
    { "id": "z5_left_foot", "type": "text", "x": 2116, "y": 400, "width": 240, "height": 50, "text": "11 of 16 were false\npositives: still broken\nafter the real fix.", "originalText": "11 of 16 were false positives", "fontSize": 12, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#5b1c10", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "groupIds": [], "seed": 160007, "version": 1, "versionNonce": 160007, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false },

