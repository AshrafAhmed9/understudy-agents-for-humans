    { "id": "z5_right_sub", "type": "text", "x": 2516, "y": 88, "width": 230, "height": 44, "text": "fails on base_commit,\npasses on base+patch", "originalText": "fails on base_commit, passes on base+patch", "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#1c3327", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "groupIds": [], "seed": 160011, "version": 1, "versionNonce": 160011, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false },
    { "id": "z5_right_num", "type": "text", "x": 2516, "y": 150, "width": 230, "height": 100, "text": "19%", "originalText": "19%", "fontSize": 72, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#2f7d52", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "groupIds": [], "seed": 160012, "version": 1, "versionNonce": 160012, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false },
    { "id": "z5_right_caption", "type": "text", "x": 2516, "y": 270, "width": 230, "height": 50, "text": "3/16 — real. Still above\nGPT-4 zero-shot's\npublished 3.6%.", "originalText": "3/16 real, above GPT-4 zero-shot 3.6%", "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#1c3327", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "groupIds": [], "seed": 160013, "version": 1, "versionNonce": 160013, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false },
    { "id": "z5_right_foot", "type": "text", "x": 2516, "y": 400, "width": 240, "height": 50, "text": "the agent never sees\nthe gold patch — only\nthis offline scorer does.", "originalText": "the agent never sees the gold patch", "fontSize": 12, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#1c3327", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "groupIds": [], "seed": 160014, "version": 1, "versionNonce": 160014, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false },

