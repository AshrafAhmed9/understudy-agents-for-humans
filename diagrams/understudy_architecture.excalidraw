    { "id": "z4_label", "type": "text", "x": 1620, "y": 20, "width": 400, "height": 26, "text": "SANDBOX — the trust boundary", "originalText": "SANDBOX — the trust boundary", "fontSize": 15, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#5c6156", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "groupIds": [], "seed": 140001, "version": 1, "versionNonce": 140001, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false },
    { "id": "z4_zone", "type": "rectangle", "x": 1620, "y": 55, "width": 380, "height": 460, "strokeColor": "#5c6156", "backgroundColor": "#e3e6db", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "groupIds": [], "seed": 140002, "version": 1, "versionNonce": 140002, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false },
    { "id": "z4_evidence_bg", "type": "rectangle", "x": 1650, "y": 90, "width": 320, "height": 300, "strokeColor": "#33372c", "backgroundColor": "#141712", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "groupIds": [], "seed": 140003, "version": 1, "versionNonce": 140003, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false },
    { "id": "z4_evidence_text", "type": "text", "x": 1666, "y": 106, "width": 288, "height": 268, "text": "docker run --rm \\\n  --network none \\\n  --memory 512m --cpus 1 \\\n  --pids-limit 128 \\\n  --user nobody \\\n  --read-only \\\n  --tmpfs /tmp \\\n  --cap-drop ALL \\\n  --security-opt no-new-privileges\n\nstdin: /dev/null\n(so input() hits EOF, not a hang)\n\nhost timeout: kills + removes\nthe container, not just the CLI", "originalText": "docker run flags", "fontSize": 12.5, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#a3a996", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "groupIds": [], "seed": 140004, "version": 1, "versionNonce": 140004, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false },
    { "id": "z4_footer", "type": "text", "x": 1650, "y": 410, "width": 320, "height": 90, "text": "gold patch applied only in a\nseparate, throwaway, trusted\ncontainer — untrusted code\nnever runs where the patch is", "originalText": "gold patch applied separately", "fontSize": 12, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#33372c", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "groupIds": [], "seed": 140005, "version": 1, "versionNonce": 140005, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false },

